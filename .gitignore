yarn-error.log*

# Archivos de sistema
.DS_Store
Thumbs.db

# Archivos de testing
/coverage
/karma-coverage

# Archivos de compilación y paquetes
*.js.map
*.d.ts
*.tgz

# Archivos específicos de Angular
/src/environments/environment.ts
/src/environments/environment.prod.ts
